{
  "schema": "formation-mechanics.v38",
  "formulas": {
    "engaged_front": "min(eligible_combatants,terrain_frontage,formation_frontage,legal_weapon_reach_frontage)",
    "experience_execution_factor": "weighted_mean(experience_execution_factor_by_fit_personnel)",
    "experience_control_modifier": "weighted_mean(experience_control_modifier_by_fit_personnel)",
    "current_attribute_mean": "stored_current_attribute_mean+settled_unit_attribute_delta",
    "current_role_skill_mean": "stored_current_skill_mean+settled_unit_skill_delta",
    "raw_successful_contacts": "engaged_front*contact_fraction+prior_contact_fraction_carry",
    "potential_contacts_per_exchange": "floor(raw_successful_contacts)",
    "new_contact_fraction_carry": "raw_successful_contacts-floor(raw_successful_contacts)",
    "new_casualty_rate": "(new_dead+new_wounded+new_captured+new_missing)/max(1,pre_contact_present_combatants_exposed_to_contact)",
    "front_rank_capacity": "floor(available_frontage*terrain_width_factor/chosen_spacing)",
    "contact_opportunities": "min(exposed_opposing_bodies,floor(legal_weapon_lanes*contact_fraction))",
    "pursuit_score": "0.30*movement_capability+0.20*current_cohesion+0.15*awareness_scouting+0.15*commander_control+0.10*morale+0.10*route_familiarity+terrain_factor+exhaustion_factor",
    "reserve_commitment_seconds": "order_delay_seconds+movement_seconds",
    "eligible_combatants": "sum(fit_present_personnel in units whose troop_type is frontage_eligible or explicitly committed)"
  },
  "contact_fraction_by_formation_margin": {
    "below_-20": 0.1,
    "-20_to_below_-5": 0.25,
    "-5_to_5": 0.5,
    "above_5_to_20": 0.7,
    "above_20": 0.9
  },
  "integrity_states": {
    "ordered": 0,
    "pressured": 0,
    "distorted": -8,
    "fragmented": -12,
    "broken": -16,
    "routing": "no_coherent_offensive_method"
  },
  "standard_exchange_seconds": {
    "close_melee_collision": 10,
    "local_heroic_action": 10,
    "formation_push": 40,
    "relief": 40,
    "short_charge": 30,
    "ordered_withdrawal_step": 40,
    "volley": "exact_weapon_cycle",
    "reserve_or_flank_movement": "actual_route_time",
    "siege_work": "actual_work_time"
  },
  "rules": {
    "contact_carry_range": "0<=carry<1 and only same continuous contact line",
    "contacts_are_opportunities_not_casualties": true,
    "named_people_resolve_exactly": true,
    "morale_authority": "data/mechanics/morale.json",
    "service_support_default_frontage": false,
    "service_support_exposure": "Service/noncombat support takes casualties when directly attacked, overrun, exposed to missiles/hazards, or explicitly committed; it does not add default offensive frontage.",
    "split_frontage_conservation": "Splitting one unit into several does not create additional terrain frontage or contact opportunities beyond real lanes and bodies."
  }
}
