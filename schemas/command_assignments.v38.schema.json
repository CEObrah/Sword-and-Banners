{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command assignments v38",
  "type": "object",
  "required": [
    "schema",
    "id",
    "records",
    "rule",
    "return_rule",
    "return_policy_default_ref"
  ],
  "properties": {
    "schema": {
      "const": "command_assignments.v38"
    },
    "id": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "return_rule": {
      "type": "string"
    },
    "return_policy_default_ref": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_owner",
          "assignment_kind",
          "receiving_commander",
          "authority_limits",
          "start",
          "return_condition",
          "return_policy_ref"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_owner": {
            "type": "string"
          },
          "assignment_kind": {
            "enum": [
              "intact_units",
              "raw_personnel"
            ]
          },
          "unit_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "raw_personnel_allocations": {
            "type": "array"
          },
          "home_chain_refs": {
            "type": "array"
          },
          "receiving_commander": {
            "type": "string"
          },
          "authority_limits": {
            "type": [
              "array",
              "object",
              "string"
            ]
          },
          "start": {
            "type": "string"
          },
          "return_condition": {
            "type": [
              "string",
              "object"
            ]
          },
          "return_policy_ref": {
            "type": "string"
          },
          "temporary_formation_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "description": "Assignments change command authority, not ownership. Intact units keep home identity; raw personnel may remain unorganized until the receiving commander lawfully creates homogeneous units."
}
