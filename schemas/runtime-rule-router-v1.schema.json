{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "purpose",
    "domains"
  ],
  "properties": {
    "schema": {
      "const": "runtime-rule-router.v1"
    },
    "purpose": {
      "type": "string"
    },
    "domains": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
