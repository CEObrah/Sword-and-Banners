{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "count",
    "identities"
  ],
  "properties": {
    "schema": {
      "const": "latent-identity-catalog"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "identities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_hint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
