  "recruitment": {
    "emergency_rule": "Emergency militia remain militia until they complete the applicable Corps qualification path.",
    "forecast_annual_normal_separation_basis_points": 180,
    "forecast_rule": "This is a planning forecast for training-pipeline depth, not an automatic retirement/death rate. Actual separations remain causal; unused qualified candidates remain conserved reserved people until admitted or released.",
    "outside_applicant_runtime": {
      "conservation_rule": "Bodies leave an exact source civilian locality, travel through the population-mobility owner, and enter Tang Manor civilian population on arrival before any candidate reservation or Corps transfer.",
      "guarantee_rule": "Relocation guarantees residence and consideration eligibility only. It never guarantees selection, training completion, rank, billet, or active-service appointment.",
      "semantic_action": "house_action:accept_bastion_applicants",
      "sequence": [
        "accept willing applicants",
        "physical migration to Tang Manor",
        "arrival as ordinary resident applicants",
        "Corps selection",
        "qualification training",
        "admission only into a real vacancy"
      ]
    },
    "ownership_rule": "Applicants become permanent House Tang service personnel, never contract mercenaries.",
    "replacement_rule": "Forecast vacancies from retirement, death, disability, lawful departure, and authorized expansion; recruit early enough that training pipelines can overlap expected vacancies.",
    "source_priority": [
      "Tang Manor civilians for future normal replacement/expansion",
      "lawful outside applicants who permanently relocate to Tang Manor"
    ],
    "throughput_rule": "Training throughput is derived from instructors, barracks, ranges, workshops, practice works, equipment, food, and time. No arbitrary monthly recruitment cap is authoritative."
  },
  "retirement": {
    "body_rule": "Due aggregate rank-and-file return to Tang Manor civilian veteran strata. The same force loses those bodies and gains vacancies; no replacement is created by retirement.",
    "cadre_rule": "Surviving earned officer grades remain attached to the formation/corps unless explicitly retired, transferred, promoted, demoted, or killed.",
    "completion_window_months": 60,
    "minimum_service_months": 240,
    "named_person_rule": "Named/person-lite/full officers retire only through explicit career/service events; aggregate retirement never silently removes them."
  },
