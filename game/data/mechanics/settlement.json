{
  "schema": "settlement-mechanics.v38",
  "formulas": {
    "food_balance": "opening_edible_stock+production+imports-civilian_consumption-military_consumption-exports-spoilage-seizure",
    "recruitment_availability": "eligible_population-essential_labor_floor-current_service-disability-protected_dependents-recent_levy_exhaustion",
    "cycle_output": "base_capacity*input_completion*skilled_labor_factor*tool_condition_factor*attendance*quality_factor",
    "daily_progress_labor": "available_laborers*attendance*skill_tool_factor*weather_security_factor",
    "estate_net_cash": "realized_sales+rents+transfers_in-wages-purchased_inputs-maintenance-taxes-debt_service-losses-transfers_out",
    "exposure_pressure": "infectious_contacts+contaminated_water_food+vector_exposure+corpse_waste_exposure-isolation-sanitation-protective_behavior",
    "population_resistance": "nutrition+prior_resistance+shelter+medical_support-exhaustion-crowding-concurrent_illness",
    "new_cases": "floor(exposed_susceptible*contact_fraction+prior_fractional_carry)",
    "activity_progress": "max(0,current_work_score-difficulty+10)",
    "levy_total_burden": "cash_paid+food_transport_consumed+equipment_supervision+lost_output_tax+household_relief+expected_desertion_disorder_political_cost",
    "disease_margin": "exposure_pressure-population_resistance",
    "new_case_fractional_carry": "exposed_susceptible*contact_fraction+prior_fractional_carry-new_cases"
  },
  "rules": {
    "outputs_conserve_people_stock_cash_and_labor": true,
    "disease_contact_fraction_must_come_from_registered_pressure_resistance_band": true,
    "project_progress_is_capped_by_workfront_supervision_tools_materials_and_coordination": true,
    "new_cases_capped_by_actual_exposed_susceptible": true
  },
