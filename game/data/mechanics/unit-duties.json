{
  "schema": "unit-duty-registry",
  "authority": "Canonical deterministic standing Unit duties. Duties are temporary assignments to existing formations, never troop types or new manpower owners.",
  "rules": {
    "assignment_scope": "A parent command assigns duties to eligible direct Units. Existing 1,000/500/100 command echelons handle routine internal allocation without creating persistent subunits.",
    "materialization_boundary": "Materialize a detachment only when it physically separates enough for location, command, casualties, supply, or information to diverge from the parent Unit.",
    "composition_rule": "Suitability uses actual current troop composition. Cavalry, missile troops, infantry, chariots, and artillery matter when a duty benefits from them; no permanent scout, engineer, signal, medical, baggage-guard, or labor troop role exists.",
    "same_rules_for_npcs": true
  },
