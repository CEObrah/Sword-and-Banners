{
  "schema": "settlement-civic-mechanics",
  "local_justice": {
    "principle": "material local cases are exact records; allegation, evidence, judgment and hidden objective fact remain separate",
    "case_kinds": ["theft", "violence", "corruption", "tax_dispute", "banditry", "desertion", "property", "contract", "other"],
    "dispositions": ["dismissed", "remedy", "sanction", "escalated"]
  },
  "outbreak": {
    "review_hours": 24,
    "minimum_seed_cases": 2,
    "maximum_seed_cases": 50,
    "route_export_fraction": 0.01,
    "quarantine_isolation_points_per_strength": 0.2,
    "fatality_reduction_per_resistance_point": 0.003,
    "severity": {
      "mild": {"daily_resolution_fraction": 0.2, "fatality_fraction_of_resolved": 0.002},
      "moderate": {"daily_resolution_fraction": 0.14, "fatality_fraction_of_resolved": 0.02},
      "severe": {"daily_resolution_fraction": 0.1, "fatality_fraction_of_resolved": 0.08},
      "critical": {"daily_resolution_fraction": 0.08, "fatality_fraction_of_resolved": 0.2}
    }
  },
  "principles": {
    "no_household_simulation": true,
    "no_duplicate_population_owner": true,
    "named_person_health_remains_exact_person_authority": true,
    "propagation_requires_actual_route_and_destination_population": true
  }
}
