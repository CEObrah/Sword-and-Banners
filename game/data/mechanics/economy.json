  "state_fiscal_model": {
    "administration_realization": {
      "diminishing_scale": 80.0,
      "floor_factor": 0.45,
      "formula": "floor_factor + marginal_factor * (1 - exp(-administrative_capacity / diminishing_scale))",
      "marginal_factor": 0.75,
      "rule": "Administrative capacity has diminishing fiscal returns rather than a hard ceiling."
    },
    "civil_administration_silver_per_controlled_civilian_month": 0.18,
    "conquest_rule": "Current controller may collect from a foreign local tax base only through exact occupation compliance/realization and the native private economy; conquest never clones a tax base.",
