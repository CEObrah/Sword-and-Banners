  "instructor": {
    "quality_formula": "clamp(0.78 + min(0.32,teaching_capability/300) + min(0.25,max(0,instructor_domain_skill-trainee_skill)/320),0.75,1.35)",
    "self_practice_rule": "use factor_tables.self_practice for the selected mode",
    "mass_delivery_rule": "Formation training follows the saved command hierarchy. The top commander and explicit training/operations staff set and inspect the standard for directly commanded Units; Unit command trains subordinate 1000 command; 1000 trains 500; 500 trains 100; 100-commanders conduct hands-on troop drill. No Units-per-instructor cap, troops-per-instructor formula, or separate trainer manpower class exists.",
    "direct_personalized_group_max_students": 8,
    "unit_delivery_rule": "The command hierarchy is the training delivery network. Formation size alone never reduces training. Missing or unstaffed required command echelons reduce delivery coverage; aggregate established command posts count as staffed unless explicitly vacant.",
    "direct_instruction_rule": "Personalized exact-person coaching is a separate small-group mode with real instructor time accounting. Mass military training is hierarchy propagation and has no arbitrary senior-instructor Unit cap.",
    "hierarchical_propagation": true
  },
  "capacity": {
    "formula": "min(instructor_hours/required_instructor_hours,facility_slots/required_slots,equipment_sets/required_sets,1)",
    "zero_denominator_rule": "a requirement of 0 contributes factor 1; a positive requirement with zero available capacity contributes 0"
  },
  "formulas": {
    "raw_EDU": "verified_hours * competency_share * intensity_factor * practice_mode_factor * instruction_factor * instructor_capacity_factor * facility_factor * equipment_factor * health_factor * recovery_factor * feedback_factor * age_factor * aptitude_factor * potential_factor * relevance_factor * interruption_completion_factor * representation_efficiency",
    "diminishing_factor": "if score<=ceiling-20:1.0; if ceiling-20<score<=ceiling:1.0-(score-(ceiling-20))*(0.55/20); if ceiling<score<=ceiling+20:0.45-(score-ceiling)*(0.35/20); if score>ceiling+20:0.05",
    "effective_EDU": "raw_EDU*diminishing_factor",
    "skill_next_point_cost": "18*(1+current_score/50)^1.75",
    "specialization_next_point_cost": "15*(1+current_score/50)^1.65",
    "attribute_next_point_cost": "120*(1+current_score/50)^2.10",
    "rust_penalty_fraction": "if unused_days<=180:0; otherwise min(0.08,0.01*floor((unused_days-180)/90))",
    "annual_physical_age_pressure_points": "if age<=35 or current_score<=50:0; otherwise max(0,(age-35)*(current_score-50)/1000)*health_pressure_factor*(1+0.5*deprivation_fraction)*(1-0.75*clamp(maintenance_factor,0,1))"
  },
  "aging": {
    "health_pressure_factor": {
      "fit": 1.0,
      "stable": 1.0,
      "minor_limitation": 1.15,
      "recovering": 1.35,
      "serious": 1.75,
      "critical": 2.25,
      "unfit": 2.25
    },
    "natural_maturation_rule": "body growth is handled by body state; permanent attributes receive no birthday or free maturation points. Attribute development still requires verified stimulus EDU.",
    "settlement": "annual; fractional age-pressure points accumulate in an aging bank and remove one permanent point only when bank>=1, iteratively, preserving remainder"
  },
  "experience": {
