{
  "schema": "career-mechanics.v38",
  "formulas": {
    "personal_command_score": "0.22*Leadership+0.22*Formation_Command+0.16*Tactics+0.10*Strategy+0.10*Composure+0.08*Logistics+0.06*Intelligence+0.06*Training",
    "small_unit_personal_command_score": "0.22*Leadership+0.22*Formation_Command+0.26*Tactics+0.10*Composure+0.08*Logistics+0.06*Intelligence+0.06*Training when Tactics>Strategy; otherwise standard formula",
    "army_personal_command_score": "0.22*Leadership+0.22*Formation_Command+0.26*Strategy+0.10*Composure+0.08*Logistics+0.06*Intelligence+0.06*Training when Strategy>Tactics; otherwise standard formula",
    "effective_command_capacity": "personal_command_score*qualification_factor*doctrine_familiarity*staff_factor*subordinate_factor*communications_factor*cohesion_factor*health_factor*fatigue_factor*terrain_complexity_factor*political_authority_factor",
    "merit_base_value": "objective_value*difficulty*responsibility*result_quality*evidence_reliability*institutional_relevance",
    "merit_final_value": "merit_base_value*casualty_factor*order_compliance_factor*legality_factor*political_factor*deception_factor"
  },
