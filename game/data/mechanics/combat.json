{
  "schema": "combat-mechanics",
  "formulas": {
    "readiness_factor": "0.60 + 0.40*readiness_fraction",
    "injury_factor": "max(0.10,1-combined_relevant_impairment/100)",
    "core_capability_factor": "readiness_factor*fatigue_factor*injury_factor",
    "usable_value": "permanent_value*core_capability_factor",
    "comfortable_combat_load_kg": "8 + 0.18*Strength + 0.08*Endurance",
    "combat_load_ratio": "total_body_load_kg/comfortable_combat_load_kg",
    "endurance_fatigue_factor": "clamp(1.15-usable_Endurance/400,0.55,1.20)",
    "raw_fatigue_gain": "base_rate*exertion_minutes*endurance_fatigue_factor*load_fatigue*heat*terrain*injury",
    "final_fatigue": "clamp(start_fatigue+raw_fatigue_gain-supported_recovery,0,100)",
    "attack_control": "0.45*relevant_skill + 0.20*Coordination + 0.15*usable_Agility + 0.10*Awareness + 0.10*Composure + handling_adjustment + legal_position - impairments",
    "dodge_control": "0.35*Defense + 0.25*Agility + 0.15*Awareness + 0.10*Athletics + 0.10*Coordination + 0.05*Composure + movement_footing_space - armor_articulation_loss - impairments",
    "parry_control": "0.35*relevant_weapon_skill + 0.25*Defense + 0.20*Coordination + 0.10*Awareness + 0.10*Composure + weapon_handling_adjustment + guard_reach_position - impairments",
    "block_control": "0.35*Shield + 0.25*Defense + 0.15*Coordination + 0.10*Strength + 0.10*Awareness + 0.05*Composure + shield_handling_adjustment + coverage_guard_position - impairments",
    "handling_adjustment": "clamp(40*(effective_handling-1),-16,16)",
    "control_margin": "attack_control-selected_legal_defensive_control",
    "combined_pressure": "strongest + 0.55*second + 0.35*third + 0.20*fourth + 0.10*sum(later_legal_attackers)",
    "grapple_hold_score": "0.35*Grappling + 0.20*Strength + 0.20*Coordination + 0.15*Toughness + 0.10*Composure + position_support",
    "escape_score": "0.30*max(Grappling,Defense) + 0.25*Agility + 0.20*Strength + 0.15*Coordination + 0.10*Composure + base_space_ally_support",
    "condition_factor": "0.55 + 0.45*clamp(condition_fraction,0,1)",
    "attack_force": "usable_Strength*catalog_base_force*contact_grade_multiplier*motion_grade_multiplier*technique_grade_multiplier*condition_factor*legal_grip_force_factor",
    "fall_energy_j": "total_mass_kg*9.80665*vertical_height_m",
    "fall_impact_index": "sqrt(fall_energy_j)*surface_factor*orientation_factor*breakfall_factor",
    "collision_energy_j": "0.5*reduced_mass_kg*relative_speed_mps^2",
    "collision_impact_index": "sqrt(collision_energy_j)*contact_geometry_factor*bracing_factor",
    "strength_support": "clamp((usable_Strength-50)/5,-12,12)",
    "recovery_control": "recovery_class_base+0.18*relevant_skill+0.12*Coordination+0.10*load_adjusted_Agility+0.08*strength_support+handling_adjustment-load_penalty-articulation_penalty-injury_penalty-condition_penalty",
    "load_penalty": "max(0,(combat_load_ratio-0.75)*32)",
    "articulation_penalty": "max(0,(1-articulation_factor)*50)",
    "recovery_injury_penalty": "relevant_impairment*0.25",
    "recovery_condition_penalty": "(1-condition_factor)*20",
    "bow_strength_tempo": "clamp(1-max(0,draw_ratio-1)*0.12+max(0,1-draw_ratio)*0.25,0.82,1.25)",
    "ranged_fatigue_cycle_factor": "1+fatigue/125",
    "ranged_injury_cycle_factor": "1+relevant_impairment/160",
    "contact_wear": "base_contact_wear*overload_factor*material_vulnerability",
    "combined_relevant_impairment": "min(90,largest_impairment+0.35*second_impairment+0.15*third_impairment)",
    "fatigue_factor": "piecewise_linear_lookup(fatigue_factor_piecewise,current_fatigue)",
    "combat_load_agility_factor": "piecewise_lookup(combat_load_agility_factor,combat_load_ratio)",
    "breakfall_factor": "clamp(1-min(120,max(Athletics,Grappling))/300,0.55,1.00) when conscious, space exists, and reaction is legal; otherwise 1.00",
    "reduced_mass_kg": "moving_mass_kg*target_mass_kg/(moving_mass_kg+target_mass_kg)",
    "current_structural_capacity": "catalog_structural_capacity*condition_factor*durability_modifier",
    "weapon_overload_ratio": "transmitted_hard_contact_impact_index/max(1,current_structural_capacity)",
    "weapon_failure_threshold": "0.85+0.65*pre_contact_condition_fraction*durability_modifier",
    "draw_ratio": "usable_Strength/draw_power_index",
    "draw_completion": "clamp(draw_ratio,0,1)",
    "launch_power_factor": "draw_completion^1.35",
    "ranged_attack_control": "0.45*Bow*range_control_factor+0.20*Coordination+0.15*Awareness+0.10*Composure+0.10*movement_skill+handling_aim_posture_weather_elevation_movement-overbow_penalty-impairments",
    "bow_projectile_impact_index": "draw_power_index*launch_power_factor*technique_multiplier*contact_multiplier*retained_force_factor*projectile_profile_factor*condition_factor*projectile_mass_factor",
    "crossbow_projectile_impact_index": "draw_power_index*technique_multiplier*contact_multiplier*retained_force_factor*projectile_profile_factor*mechanism_condition_factor*projectile_mass_factor after verified full latch",
    "horse_fatigue_factor": "max(0.35,1-horse_fatigue/130)",
    "horse_load_ratio": "(rider_mass+rider_equipment+tack+barding+cargo)/comfortable_load",
    "effective_horse_speed": "base_speed*health_factor*horse_fatigue_factor*feed_factor*load_speed_factor*stat_derived_barding_load_factor*terrain_factor*weather_factor",
    "horse_fatigue_gain": "base_effort*load_fatigue*barding_endurance_inverse*barding_heat*climate*terrain*injury",
    "mounted_control": "0.35*Riding+0.20*Coordination+0.15*Awareness+0.10*Composure+0.10*horse_training+0.10*horse_condition+lane_terrain+40*(tack_rider_control_modifier*tack_fit-1)-impairments",
    "charge_alignment": "mounted_control*tack_charge_alignment_modifier*horse_training_alignment*barding_articulation*load_legality",
    "panic_control": "0.35*horse_training+0.20*Riding+0.15*horse_condition+0.15*Composure+0.15*formation_familiarity-pain_shock_fire_noise",
    "charge_collision_index": "total_horse_rider_equipment_mass*relative_speed^2/100*alignment",
    "hero_tempo": "0.25*Agility+0.20*Coordination+0.20*relevant_skill+0.15*Awareness+0.10*Mass_Combat+0.10*Endurance",
    "minimum_action_interval_seconds": "max(0.40,360/(hero_tempo+60))",
    "stat_derived_load_penalty": "max(0,(combat_load_ratio-0.75)*32)",
    "stat_derived_movement_factor": "clamp(1-stat_derived_load_penalty/(140+0.35*usable_Agility+0.25*Coordination),0.45,1)",
    "stat_derived_fatigue_multiplier": "clamp(1+max(0,combat_load_ratio-0.75)*clamp(1.15-usable_Endurance/400,0.55,1.20),1,2.75)",
    "stat_derived_recovery_factor": "clamp(1-stat_derived_load_penalty/(125+0.30*Coordination+0.20*usable_Agility+0.15*usable_Strength),0.40,1)",
    "stat_derived_helmet_vision_factor": "clamp(1-(1-vision_aperture_fraction)*clamp(1-Awareness/400,0.50,0.90),0.70,1)",
    "stat_derived_helmet_hearing_factor": "clamp(1-hearing_occlusion_fraction*clamp(1-Awareness/450,0.55,0.95),0.70,1)",
    "stat_derived_horse_barding_factor": "derive from horse_load_ratio, mount Strength/Endurance/Agility, barding mass, articulation and heat; no fixed pattern speed penalty for stat-derived barding",
    "action_ready_time": "next_ready_at=max(action_start+minimum_action_interval_seconds,contact_or_completion_at+action_specific_recovery_seconds)",
    "reaction_ready_time": "reaction_origin+reaction_seconds*commitment_factor; defense is full only when reaction_ready_time<=incoming_contact_time",
    "weapon_penetration_index": "attack_force*weapon_mode_geometry_penetration_factor; attack_force and penetration share the same strength/speed/contact event rather than independent special-power scales",
    "shield_penetration": "intercepted_penetration_index versus condition-adjusted shield penetration_capacity; perforation may pass residual penetration without requiring total shield structural failure",
    "armor_residual_penetration": "max(0,incoming_penetration_index-contacted_channel_protection) after shield residual; only residual penetration and transmitted impact reach anatomy",
    "adaptive_action_selection": "score each physically legal attack method from target structure/coverage, weapon geometry, distance/current state, recent failures/repetitions and demonstrated defense; explicit player wording overrides selection"
  },
