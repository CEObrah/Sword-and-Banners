  "timing_model": {
    "mode": "continuous_action_ready",
    "initiative_rule": "initiative chooses initial local start timing only; it never grants a permanent turn order",
    "action_rule": "movement, attack startup, contact, defense reaction and recovery each consume their own physical duration",
    "concurrency_rule": "actors retain independent ready/action clocks; a faster actor may complete multiple actions while a slower committed action is still resolving",
    "defense_rule": "a defender may abort a committed action to react if physical reaction time permits; doing so consumes defender readiness",
    "no_turn_entitlement": true,
    "stat_ceiling_rule": "character and cohort combat stats are not capped at 200; physical floors/geometry/recovery may bound outcomes without erasing values above 200"
  },
  "sequencing_rules": {
    "no_static_best_action_spam": "A legal high-scoring method is penalized when repeated into the same failed defense/target line; the actor reevaluates target, method, distance and opponent response when it becomes action-ready.",
    "state_inputs": [
      "distance/reach",
      "target anatomy/function",
      "actual armor/shield coverage and condition",
      "recent action outcomes",
      "last demonstrated defense",
      "current weapon/mount state",
      "injuries/fatigue",
      "declared player intent"
    ],
    "player_override": "Explicit player target/method/action sequence is never silently replaced by adaptive automation.",
    "determinism": "Adaptive selection is deterministic from saved/current causal state; it is not random move rotation."
  },
