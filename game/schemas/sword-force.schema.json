{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allocated_to_formations": {
      "type": "object"
    },
    "available_by_role": {
      "type": "object"
    },
    "cohort_ledger": {
      "type": "object",
      "required": [
        "schema",
        "cohorts"
      ],
      "properties": {
        "schema": {
          "const": "force-cohort-ledger"
        },
        "cohorts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "cohort_id",
              "role",
              "origin",
              "reserve_by_location",
              "allocated_by_formation"
            ],
            "properties": {
              "cohort_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "origin": {
                "type": "object"
              },
              "reserve_by_location": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "allocated_by_formation": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "age_distribution": {
                "type": "object"
              },
              "aptitude_means": {
                "type": "object"
              },
              "attribute_means": {
                "type": "object"
              },
              "attribute_sd": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                ]
              },
              "skill_means": {
                "type": "object"
              },
              "skill_sd": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                ]
              },
              "skill_edu_banks": {
                "type": "object"
              },
              "attribute_edu_banks": {
                "type": "object"
              },
              "aptitude_sd": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "headcount": {
      "type": "integer",
      "minimum": 0
    },
    "owner_id": {
      "type": "string"
    },
    "schema": {
      "const": "sword-force"
    },
    "administrative_owner": {},
    "authorized_by_role": {},
    "authorized_strength": {},
    "available_by_location": {},
    "available_equipment_by_location": {},
    "available_equipment_units_by_role": {},
    "capacity_policy": {},
    "cohort_training_closes": {},
    "command_establishment": {},
    "command_group_ref": {},
    "command_hierarchy_ref": {},
    "commander_ref": {},
    "corps_name": {},
    "demobilized_at": {},
    "demobilized_cohort_snapshot": {},
    "equipment_reserve_by_location": {},
    "equipment_reserve_by_role": {},
    "external_personnel_allocations": {},
    "fighting_establishment": {},
    "force_role": {},
    "formation_authorizations": {},
    "geographic_disposition": {},
    "infrastructure": {},
    "institution_ref": {},
    "institutional_reserve_silver": {},
    "kind": {},
    "last_review": {},
    "materialized_assignments": {},
    "materialized_people": {},
    "officer_establishment": {},
    "owner_type": {},
    "personnel_pipeline": {},
    "provenance": {},
    "recruitment_history": {},
    "representation": {},
    "service_class": {},
    "source_location_ref": {},
    "standing_formation_refs": {},
    "state": {},
    "status": {},
    "support_treasury_ref": {},
    "training_policy_ref": {},
    "cohort_training_hours": {
      "type": "integer",
      "minimum": 0
    },
    "last_training_at": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "owner_id",
    "headcount",
    "available_by_role",
    "allocated_to_formations"
  ],
  "type": "object"
}
