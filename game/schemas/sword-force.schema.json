          "additionalProperties": {
            "type": "object",
            "required": [
              "cohort_id",
              "role",
              "origin",
              "reserve_by_location",
              "allocated_by_formation"
            ],
            "properties": {
              "cohort_id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "origin": {
                "type": "object"
              },
              "reserve_by_location": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "allocated_by_formation": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "age_distribution": {
                "type": "object"
              },
              "aptitude_means": {
                "type": "object"
              },
              "attribute_means": {
                "type": "object"
              },
              "attribute_sd": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                ]
              },
              "skill_means": {
                "type": "object"
              },
              "skill_sd": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                ]
              },
              "skill_edu_banks": {
                "type": "object"
              },
              "attribute_edu_banks": {
                "type": "object"
              },
              "aptitude_sd": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "headcount": {
      "type": "integer",
      "minimum": 0
    },
    "owner_id": {
      "type": "string"
    },
    "schema": {
      "const": "sword-force"
    }
  },
  "required": [
    "schema",
    "owner_id",
    "headcount",
    "available_by_role",
    "allocated_to_formations"
  ],
  "type": "object"
}
