{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lossless period shard of attributed scene history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "mechanical_consequence_authority", "period_ref", "previous_period_ref", "records"],
  "properties": {
    "schema": {"const": "sword-scene-history-shard"},
    "authority": {"const": false},
    "mechanical_consequence_authority": {"const": false},
    "period_ref": {"type": "string", "minLength": 1},
    "previous_period_ref": {"type": ["string", "null"]},
    "records": {"type": "array", "maxItems": 512, "items": {"type": "object", "additionalProperties": false, "required": ["speech_ref", "at", "session_ref", "speaker_ref", "speech_kind", "statement", "basis_refs", "resolves_question_ref", "truth_status", "authority", "mechanical_consequence_authority"], "properties": {
      "speech_ref": {"type": "string", "minLength": 1}, "at": {"type": "string", "minLength": 1}, "session_ref": {"type": "string", "minLength": 1}, "speaker_ref": {"type": "string", "minLength": 1},
      "speech_kind": {"enum": ["clarification", "opinion", "inference", "question", "nonbinding_proposal", "nonbinding_response", "observation", "advice", "objection"]},
      "statement": {"type": "string", "minLength": 1, "maxLength": 2500}, "basis_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "resolves_question_ref": {"type": ["string", "null"]}, "truth_status": {"const": "attributed_statement"}, "authority": {"const": false}, "mechanical_consequence_authority": {"const": false}
    }}}
  }
}
