{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational formation v38",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "commander_id",
    "unit_refs",
    "location",
    "objective",
    "posture",
    "current_orders"
  ],
  "properties": {
    "schema": {
      "const": "formation.v38"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "commander_id": {
      "type": "string"
    },
    "command_owner_id": {
      "type": "string"
    },
    "unit_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "formation_template_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "posture": {
      "type": "string"
    },
    "current_orders": {
      "type": [
        "object",
        "array",
        "string"
      ]
    },
    "integrity": {
      "type": [
        "number",
        "integer"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "temporary": {
      "type": "boolean"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "troop_pools"
        ]
      },
      {
        "required": [
          "manpower_pools"
        ]
      }
    ]
  },
  "additionalProperties": true,
  "description": "A formation is a temporary operational arrangement that references existing units. It owns no manpower and never replaces unit ownership."
}
