{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Military reconnaissance routing index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "reconnaissance",
    "active_by_actor"
  ],
  "properties": {
    "schema": {"const": "sword-military-reconnaissance-index"},
    "authority": {"const": false},
    "reconnaissance": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "active_by_actor": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      }
    }
  }
}
