{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Process contract registry v39",
  "type": "object",
  "required": [
    "schema",
    "owner_id",
    "owner_type",
    "record_count",
    "record_path_template"
  ],
  "properties": {
    "schema": {
      "const": "process-contract-registry"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_type": {
      "type": "string"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "record_path_template": {
      "type": "string"
    },
    "autonomous_world_contract": {
      "type": "string"
    },
    "autonomous_action_rule": {
      "type": "string"
    },
    "retrieval_rule": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
