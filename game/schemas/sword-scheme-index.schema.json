{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "authority",
    "schemes",
    "active_refs"
  ],
  "properties": {
    "schema": {
      "const": "sword-scheme-index"
    },
    "authority": {
      "const": false
    },
    "schemes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "active_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
