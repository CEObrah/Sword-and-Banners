{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "battlefield_ref",
    "status",
    "side_refs",
    "sectors",
    "sector_edges",
    "assignments",
    "reports",
    "opened_at",
    "last_settled_at"
  ],
  "properties": {
    "schema": {
      "const": "sword-operational-battlefield"
    },
    "battlefield_ref": {
      "type": "string",
      "pattern": "^battlefield_"
    },
    "status": {
      "enum": [
        "active",
        "closed"
      ]
    },
    "side_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sectors": {
      "type": "object"
    },
    "sector_edges": {
      "type": "array"
    },
    "assignments": {
      "type": "object"
    },
    "reports": {
      "type": "array"
    },
    "opened_at": {
      "type": "string"
    },
    "last_settled_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
