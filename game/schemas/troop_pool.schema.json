{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Troop Pool",
  "description": "Homogeneous accounting-only manpower source. It cannot fight. Current population capability lives behind capability_ref; organized units own battlefield state.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "count",
    "capability_ref"
  ],
  "properties": {
    "schema": {
      "const": "troop_pool"
    },
    "id": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "capability_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
