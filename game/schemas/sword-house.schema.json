{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "house_ref": {},
    "lineage_cohort": {},
    "owner_id": {},
    "schema": {
      "const": "sword-house"
    },
    "state": {},
    "nobility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "grade": {
          "enum": [
            "unranked_house",
            "recognized_house",
            "minor_noble_house",
            "noble_house",
            "high_noble_house",
            "great_noble_house"
          ]
        },
        "last_changed_at": {
          "type": "string"
        },
        "last_grant_ref": {
          "type": "string"
        },
        "last_grantor_ref": {
          "type": "string"
        },
        "last_evidence_ref": {
          "type": "string"
        }
      },
      "required": [
        "grade"
      ]
    }
  },
  "required": [
    "schema",
    "owner_id",
    "house_ref",
    "state",
    "lineage_cohort",
    "nobility"
  ],
  "type": "object"
}
