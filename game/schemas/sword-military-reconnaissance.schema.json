{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causal military reconnaissance process",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner_id",
    "reconnaissance_ref",
    "issuer_ref",
    "formation_ref",
    "scout_commander_ref",
    "operation_ref",
    "region_ref",
    "target_state_ref",
    "report_to_ref",
    "observation_hours",
    "status",
    "phase",
    "started_at",
    "observation_due_at",
    "report_information_ref",
    "report_event_ref",
    "report_dispatched_at",
    "report_delivered_at",
    "report_target_location_ref",
    "courier_origin_ref",
    "scout_start_location_ref",
    "scout_start_personnel",
    "scout_commander_name"
  ],
  "properties": {
    "schema": {"const": "sword-military-reconnaissance"},
    "owner_id": {"type": "string", "minLength": 1},
    "reconnaissance_ref": {"type": "string", "minLength": 1},
    "issuer_ref": {"type": "string", "minLength": 1},
    "formation_ref": {"type": "string", "minLength": 1},
    "scout_commander_ref": {"type": "string", "minLength": 1},
    "operation_ref": {"type": "string", "minLength": 1},
    "region_ref": {"type": "string", "minLength": 1},
    "target_state_ref": {"type": "string", "minLength": 1},
    "report_to_ref": {"type": "string", "minLength": 1},
    "observation_hours": {"type": "integer", "minimum": 1, "maximum": 24},
    "status": {"enum": ["active", "completed"]},
    "phase": {"enum": ["observing", "report_in_transit", "completed"]},
    "started_at": {"type": "string", "minLength": 1},
    "observation_due_at": {"type": "string", "minLength": 1},
    "observation_completed_at": {"type": "string", "minLength": 1},
    "report_information_ref": {"type": ["string", "null"]},
    "report_event_ref": {"type": ["string", "null"]},
    "report_dispatched_at": {"type": ["string", "null"]},
    "report_delivered_at": {"type": ["string", "null"]},
    "report_target_location_ref": {"type": ["string", "null"]},
    "courier_origin_ref": {"type": "string", "minLength": 1},
    "scout_start_location_ref": {"type": "string", "minLength": 1},
    "scout_start_personnel": {"type": "integer", "minimum": 1},
    "scout_commander_name": {"type": ["string", "null"]},
    "completed_at": {"type": "string", "minLength": 1},
    "observation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_observation",
        "confirmed_enemy_formation_count",
        "confirmed_enemy_strength",
        "confidence_milli",
        "route_approach_count",
        "evidence_commitment"
      ],
      "properties": {
        "valid_observation": {"type": "boolean"},
        "confirmed_enemy_formation_count": {"type": "integer", "minimum": 0},
        "confirmed_enemy_strength": {"type": "integer", "minimum": 0},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "route_approach_count": {"type": "integer", "minimum": 0},
        "evidence_commitment": {"type": "string"}
      }
    }
  }
}
