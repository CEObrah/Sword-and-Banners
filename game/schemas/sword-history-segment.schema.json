{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sword semantic history archive segment",
  "type": "object",
  "required": [
    "schema",
    "owner_id",
    "authority",
    "segment_number",
    "event_count",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "sword-history-segment"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^semantic_history_segment_[0-9]{6}$"
    },
    "authority": {
      "const": true
    },
    "segment_number": {
      "type": "integer",
      "minimum": 1
    },
    "event_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "first_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
