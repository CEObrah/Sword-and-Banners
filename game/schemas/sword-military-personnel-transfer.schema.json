{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact military personnel transfer",
  "type": "object",
  "required": ["schema", "owner_id", "order_ref", "officer_ref", "state_ref", "request_kind", "target_formation_ref", "departed_at", "arrives_at", "travel_hours", "status", "authority_rule"],
  "properties": {
    "schema": {"const": "sword-military-personnel-transfer.v1"},
    "owner_id": {"type": "string", "pattern": "^military_personnel_transfer_"},
    "order_ref": {"type": "string", "pattern": "^military_personnel_transfer_"},
    "petition_ref": {"type": "string"},
    "officer_ref": {"type": "string"},
    "state_ref": {"type": "string", "pattern": "^state_"},
    "request_kind": {"type": "string"},
    "desired_commander_ref": {"type": ["string", "null"]},
    "source_formation_ref": {"type": ["string", "null"]},
    "target_formation_ref": {"type": "string"},
    "source_force_ref": {"type": ["string", "null"]},
    "target_force_ref": {"type": ["string", "null"]},
    "included_in_force_headcount": {"type": "boolean"},
    "role": {"type": "string"},
    "source_location_ref": {"type": "string"},
    "destination_location_ref": {"type": "string"},
    "departed_at": {"type": "string"},
    "arrives_at": {"type": "string"},
    "travel_hours": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ordered", "in_transit", "rerouted", "completed", "blocked_after_reroute", "blocked_target_missing", "blocked_vacancy_filled"]},
    "authority_rule": {"type": "string"},
    "completed_at": {"type": "string"},
    "blocked_at": {"type": "string"},
    "blocked_reason": {"type": "string"},
    "rerouted_at": {"type": "string"},
    "reroute_reason": {"type": "string"},
    "next_order_ref": {"type": "string"},
    "return_for_order_ref": {"type": "string"}
  },
  "additionalProperties": false
}
