{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded interaction-attempt routing ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "purpose", "total_recorded", "attempts"],
  "properties": {
    "schema": {"const": "sword-interaction-attempt-ledger"},
    "authority": {"const": false},
    "purpose": {"type": "string", "minLength": 1},
    "total_recorded": {"type": "integer", "minimum": 0},
    "attempts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id", "at", "surface_digest", "actor_id",
          "target_ref", "action", "process_ref", "player_statement",
          "formation_refs", "posture", "world_response_status"
        ],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "at": {"type": "string", "minLength": 1},
          "surface_digest": {"type": "string", "minLength": 1},
          "actor_id": {"type": "string", "minLength": 1},
          "target_ref": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "process_ref": {"type": ["string", "null"]},
          "player_statement": {"type": ["string", "null"]},
          "formation_refs": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "posture": {"type": ["string", "null"]},
          "world_response_status": {"const": "not_established_by_attempt"}
        }
      }
    }
  }
}
