{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Materialized homogeneous military unit",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "owner",
    "troop_type",
    "personnel",
    "loadout_standard",
    "doctrine",
    "training",
    "location",
    "capability",
    "population_profile"
  ],
  "properties": {
    "schema": {
      "const": "unit"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "home_establishment_ref": {
      "type": "string"
    },
    "troop_type": {
      "type": "string"
    },
    "personnel": {
      "type": "object",
      "required": [
        "representation",
        "count",
        "source_claims"
      ],
      "properties": {
        "representation": {
          "const": "aggregate"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "source_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_ref",
              "count",
              "transaction_ref",
              "claim_kind"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "transaction_ref": {
                "type": "string",
                "minLength": 1
              },
              "claim_kind": {
                "type": "string",
                "minLength": 1
              },
              "service_model": {
                "type": "string"
              },
              "generation_schema": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "member_ids": {
          "type": "array",
          "maxItems": 0
        },
        "condition": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "loadout_standard": {
      "type": "string",
      "minLength": 1
    },
    "doctrine": {
      "type": "string"
    },
    "training": {
      "type": "string"
    },
    "commander_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": "string"
    },
    "cohesion": {},
    "morale": {},
    "readiness": {},
    "lineage": {
      "type": "object"
    },
    "issue_state": {
      "type": "object",
      "description": "Exception-only actual issue/readiness state. Absence means no separately materialized issue exception. It may record shortages, damage, substitutes, ammunition, mount/equipment availability or repair state but never a second intended organizational standard.",
      "properties": {
        "status": {
          "enum": [
            "fully_issued",
            "under_issued",
            "damaged",
            "substitute_issue",
            "mixed_exceptions"
          ]
        },
        "completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "missing": {
          "type": "object"
        },
        "damaged": {
          "type": "object"
        },
        "substitutes": {
          "type": "object"
        },
        "ammunition_state": {
          "type": "object"
        },
        "mount_issue_state": {
          "type": "object"
        },
        "repair_backlog": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "alternate_loadout"
            ]
          },
          {
            "required": [
              "secondary_standard"
            ]
          },
          {
            "required": [
              "loadout_standard_distribution"
            ]
          }
        ]
      }
    },
    "refit_state": {
      "type": "object",
      "description": "Optional transition to a future standard. The current unit standard remains authoritative for organizational identity until refit completion; actual equipment during transition is resolved from issue/inventory state.",
      "required": [
        "status",
        "target_loadout_standard",
        "progress"
      ],
      "properties": {
        "status": {
          "enum": [
            "planned",
            "awaiting_stock",
            "issuing",
            "fitting",
            "familiarizing",
            "paused"
          ]
        },
        "target_loadout_standard": {
          "type": "string",
          "minLength": 1
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "reserved_inventory_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "familiarization_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "representation",
        "as_of",
        "stat_order_ref",
        "sample_count",
        "attributes",
        "skills",
        "aptitudes"
      ],
      "properties": {
        "representation": {
          "const": "aggregate_moments"
        },
        "as_of": {
          "type": "string"
        },
        "stat_order_ref": {
          "type": "string"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "attributes": {
          "type": "object",
          "required": [
            "mean",
            "variance",
            "min",
            "max"
          ],
          "properties": {
            "mean": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": {
                "type": "number"
              }
            },
            "variance": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": {
                "type": "number"
              }
            },
            "min": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": {
                "type": "number"
              }
            },
            "max": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "required": [
            "mean",
            "variance",
            "min",
            "max"
          ],
          "properties": {
            "mean": {
              "type": "array",
              "minItems": 21,
              "maxItems": 21,
              "items": {
                "type": "number"
              }
            },
            "variance": {
              "type": "array",
              "minItems": 21,
              "maxItems": 21,
              "items": {
                "type": "number"
              }
            },
            "min": {
              "type": "array",
              "minItems": 21,
              "maxItems": 21,
              "items": {
                "type": "number"
              }
            },
            "max": {
              "type": "array",
              "minItems": 21,
              "maxItems": 21,
              "items": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "aptitudes": {
          "type": "object",
          "required": [
            "order",
            "mean",
            "variance",
            "min",
            "max"
          ],
          "properties": {
            "order": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "string"
              }
            },
            "mean": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "number"
              }
            },
            "variance": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "number"
              }
            },
            "min": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "number"
              }
            },
            "max": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "population_profile": {
      "type": "object",
      "required": [
        "age_distribution",
        "body_distribution",
        "experience_distribution",
        "qualification_distribution"
      ],
      "properties": {
        "age_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "body_distribution": {
          "type": "object",
          "required": [
            "adult_height_cm",
            "current_weight_kg",
            "frame_distribution"
          ],
          "properties": {
            "adult_height_cm": {
              "type": "object",
              "required": [
                "mean",
                "variance",
                "min",
                "max"
              ],
              "properties": {
                "mean": {
                  "type": "number"
                },
                "variance": {
                  "type": "number",
                  "minimum": 0
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "current_weight_kg": {
              "type": "object",
              "required": [
                "mean",
                "variance",
                "min",
                "max"
              ],
              "properties": {
                "mean": {
                  "type": "number"
                },
                "variance": {
                  "type": "number",
                  "minimum": 0
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "frame_distribution": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "additionalProperties": false
        },
        "experience_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "qualification_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "not": {
        "required": [
          "loadout_distribution"
        ]
      }
    },
    {
      "not": {
        "required": [
          "troop_type_distribution"
        ]
      }
    },
    {
      "not": {
        "required": [
          "doctrine_distribution"
        ]
      }
    },
    {
      "not": {
        "required": [
          "training_distribution"
        ]
      }
    },
    {
      "not": {
        "required": [
          "commander_distribution"
        ]
      }
    },
    {
      "not": {
        "required": [
          "loadout_standard_distribution"
        ]
      }
    },
    {
      "not": {
        "required": [
          "alternate_loadout_distribution"
        ]
      }
    }
  ]
}
