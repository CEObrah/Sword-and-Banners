{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "succession_id",
    "authority",
    "subject_owner_id",
    "status",
    "rule_basis",
    "current_holder_id",
    "candidate_order"
  ],
  "properties": {
    "schema": {
      "const": "family-succession"
    },
    "succession_id": {
      "type": "string"
    },
    "authority": {
      "const": true
    },
    "subject_owner_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "disputed",
        "vacant",
        "resolved",
        "suspended"
      ]
    },
    "rule_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_holder_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_order": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "person_id",
          "basis"
        ],
        "properties": {
          "person_id": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
