{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject_ref",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "sword-npc-cognition"
    },
    "subject_ref": {
      "type": "string"
    },
    "entries": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cognition_ref": {
            "type": "string"
          },
          "subject_ref": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "maxLength": 900
          },
          "epistemic_status": {
            "enum": [
              "belief",
              "intention",
              "interpretation",
              "recollection"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 600
          },
          "salience": {
            "enum": [
              "important",
              "defining"
            ]
          },
          "status": {
            "enum": [
              "active",
              "resolved"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "previous_history_ref": {
            "type": "string"
          },
          "basis_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "attribution": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "summary": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "truth_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "ref",
                "at",
                "attribution",
                "summary",
                "truth_status"
              ]
            }
          },
          "campaign_revision": {
            "type": "integer",
            "minimum": 1
          },
          "world_truth_authority": {
            "const": false
          },
          "mechanical_consequence_authority": {
            "const": false
          }
        },
        "required": [
          "cognition_ref",
          "subject_ref",
          "kind",
          "statement",
          "epistemic_status",
          "basis_refs",
          "basis",
          "reason",
          "salience",
          "status",
          "created_at",
          "updated_at",
          "campaign_revision",
          "world_truth_authority",
          "mechanical_consequence_authority"
        ]
      }
    }
  }
}
