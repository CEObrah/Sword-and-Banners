{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit and institutional training registry",
  "type": "object",
  "required": [
    "name",
    "owner_id",
    "owner_type",
    "records",
    "schema"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_type": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "records": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "description": "Static training contract registry. Mutable training progress lives in exact state owners and causal runtime settlement."
}
