{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "authority",
    "count",
    "profiles"
  ],
  "properties": {
    "schema": {
      "const": "behavior-profile-index"
    },
    "authority": {
      "const": false
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
