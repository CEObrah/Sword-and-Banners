              "type": "string"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guardians": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "households": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "succession_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kinships": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
