{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "commitments"
  ],
  "properties": {
    "schema": {
      "const": "sword-commitment-index"
    },
    "commitments": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "by_actor": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
