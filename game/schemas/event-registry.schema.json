{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event registry",
  "type": "object",
  "required": [
    "name",
    "owner_id",
    "owner_type",
    "records",
    "runtime",
    "schema"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_type": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "record_id"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "record_id": {
            "type": "string"
          },
          "facts": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "causal_events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "event_ref",
          "kind",
          "status",
          "due_at",
          "triggered_at",
          "summary",
          "provenance"
        ],
        "properties": {
          "event_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "status": {
            "const": "triggered"
          },
          "due_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "triggered_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "arc_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "actor_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "target_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "initiative_kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "basis_goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "result": {
            "enum": [
              "gains_ground",
              "checked",
              "inconclusive",
              "material_action_settled",
              "work_queued",
              "work_blocked",
              "intent_recorded"
            ]
          },
          "pressure_stage": {
            "enum": [
              "contained",
              "developing",
              "material",
              "acute"
            ]
          },
          "visibility_class": {
            "enum": [
              "hidden",
              "discoverable",
              "direct"
            ]
          },
          "source_event_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "process_kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "process_stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "advisory_record": {
            "type": "object",
            "required": [
              "schema",
              "speaker_ref",
              "audience_ref",
              "process_ref",
              "topics",
              "positions",
              "binding",
              "creates_policy",
              "creates_commitment",
              "creates_authority"
            ],
            "properties": {
              "schema": {
                "const": "sword-nonbinding-counsel.v1"
              },
              "speaker_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "audience_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "process_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "topics": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "uniqueItems": true
              },
              "positions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "binding": {
                "const": false
              },
              "creates_policy": {
                "const": false
              },
              "creates_commitment": {
                "const": false
              },
              "creates_authority": {
                "const": false
              }
            },
            "additionalProperties": false
          },
          "delivery": {
            "type": "object",
            "required": [
              "target_ref",
              "location_ref",
              "route"
            ],
            "properties": {
              "target_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "location_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "route": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "source_owner_ref",
                  "work_ref",
                  "late_catch_up"
                ],
                "properties": {
                  "kind": {
                    "const": "causal_runtime_settlement"
                  },
                  "source_owner_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "work_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "late_catch_up": {
                    "type": "boolean"
                  },
                  "source_work_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "arc_owner_ref",
                  "review_count",
                  "deterministic_roll"
                ],
                "properties": {
                  "kind": {
                    "const": "world_arc_causal_review"
                  },
                  "arc_owner_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "review_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "deterministic_roll": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "exposure_roll",
                  "exposure_chance"
                ],
                "properties": {
                  "kind": {
                    "const": "world_arc_information_propagation"
                  },
                  "exposure_roll": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 99
                  },
                  "exposure_chance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "player_safe_evidence_kind": {
                    "type": "string",
                    "enum": [
                      "exact_operation_created"
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "arc_owner_ref",
                  "review_count",
                  "domain_status",
                  "domain_action_ref"
                ],
                "properties": {
                  "kind": {
                    "const": "world_arc_orchestration"
                  },
                  "arc_owner_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "review_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "domain_status": {
                    "enum": [
                      "material_action_settled",
                      "work_queued",
                      "work_blocked",
                      "intent_recorded"
                    ]
                  },
                  "domain_action_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "material_evidence": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": true
                  },
                  "evidence_stage": {
                    "enum": [
                      "intent",
                      "commitment",
                      "domain_action",
                      "external_consequence"
                    ]
                  },
                  "required_evidence_stage": {
                    "enum": [
                      "intent",
                      "commitment",
                      "domain_action",
                      "external_consequence"
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "evidence_stage": {
            "enum": [
              "intent",
              "commitment",
              "domain_action",
              "external_consequence"
            ]
          },
          "required_evidence_stage": {
            "enum": [
              "intent",
              "commitment",
              "domain_action",
              "external_consequence"
            ]
          },
          "operation_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "campaign_command_cycle_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "present_person_refs": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          },
          "campaign_command_context": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "last_settled_at"
      ],
      "properties": {
        "last_settled_at": {
          "type": "string"
        },
        "player_safe_world_arc_claims": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "arc_ref",
              "evidence_kind",
              "fingerprint",
              "delivered_at"
            ],
            "properties": {
              "arc_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "evidence_kind": {
                "enum": [
                  "exact_operation_created"
                ]
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "delivered_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "schema": {
      "const": "event-registry"
    },
    "archives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_ref",
          "path",
          "event_count",
          "first_triggered_at",
          "last_triggered_at"
        ],
        "properties": {
          "segment_ref": {
            "type": "string",
            "pattern": "^causal_event_segment_[0-9]{6}$"
          },
          "path": {
            "type": "string",
            "pattern": "^state/event/archive/segment_[0-9]{6}\\.json$"
          },
          "event_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "first_triggered_at": {
            "type": "string"
          },
          "last_triggered_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "archived_event_count": {
      "type": "integer",
      "minimum": 0
    },
    "next_archive_seq": {
      "type": "integer",
      "minimum": 1
    },
    "head_limit": {
      "const": 512
    },
    "archive_segment_size": {
      "const": 256
    }
  },
  "additionalProperties": false,
  "description": "Formal top-level structure for mutable event/message/movement registries. Exact triggered events support short-horizon causal work, autonomous world-arc activity/report propagation, and bounded institutional-process follow-ups without creating a second occurrence authority."
}
