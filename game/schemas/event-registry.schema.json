{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Current canonical schema: event registry v38",
  "type":"object",
  "required":["name","owner_id","owner_type","records","runtime","schema"],
  "properties":{
    "name":{"type":"string"},
    "owner_id":{"type":"string"},
    "owner_type":{"type":"string"},
    "records":{"type":"array","items":{"type":"object","required":["label","record_id"],"properties":{"label":{"type":"string"},"notes":{"type":"array","items":{"type":"string"}},"record_id":{"type":"string"},"facts":{"type":"object"}},"additionalProperties":false}},
    "runtime":{"type":"object","required":["last_settled_at"],"properties":{"last_settled_at":{"type":"string"}},"additionalProperties":false},
