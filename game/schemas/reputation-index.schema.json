{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reputation index",
  "type": "object",
  "required": [
    "schema",
    "authority",
    "subjects",
    "subject_count"
  ],
  "properties": {
    "schema": {
      "const": "reputation-index"
    },
    "authority": {
      "const": false
    },
    "subject_count": {
      "type": "integer",
      "minimum": 0
    },
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "audience_profile_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
