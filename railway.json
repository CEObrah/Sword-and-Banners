{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/runtime/**",
      "/game/**",
      "/pyproject.toml",
      "/railway.toml",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "PYTHONPATH=/app/runtime python -m sword_runtime.bootstrap",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
